# =============================================================================
# Veto — environment variables
# This project is built on TanStack Start + Vite. Vite reads VITE_* at build
# time. The NEXT_PUBLIC_* aliases below are documented for parity with the
# external schema runner / tooling but are NOT consumed by the app.
# =============================================================================

# --- Supabase (client-visible) -----------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Aliases for external tooling (Next.js / scripts). Not read by the app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only) --------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# --- Public site origin (used in transactional emails / OG tags) ------------
VITE_SITE_ORIGIN=https://your-domain.com
SITE_URL=https://your-domain.com

# --- Waitlist / transactional email (optional) ------------------------------
RESEND_API_KEY=
WAITLIST_FROM_EMAIL="Veto <waitlist@yourdomain.com>"
WAITLIST_REPLY_TO_EMAIL=
WAITLIST_BCC_EMAIL=
WAITLIST_SKIP_EMAIL_ON_DUPLICATE=
